# Optional Smart Mode. Copy this file to .env (which is gitignored) and paste a free key from
# Google AI Studio: https://aistudio.google.com/apikey
# Leave GEMINI_API_KEY empty to use only the built-in rule-based engine (Classic Mode).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set to 0 to switch Smart Mode off without deleting the key.
GEMINI_ENABLED=1
